required_packages <- c(
"igraph",
"dplyr",
"ggraph",
"purrr",
"rnaturalearth",
"geosphere",
"sf",
"here",
"tidygraph",
"tidyr",
"patchwork",
"ggrepel",
"here"
)
for (pkg in required_packages) {
if (!requireNamespace(pkg, quietly = TRUE)) {
install.packages(pkg)
}
}
